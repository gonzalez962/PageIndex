# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible provider: API key and base URL (usually ends in /v1).
# Keyless local servers (Ollama, LM Studio, vLLM) still need a placeholder key.
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://your-provider.example.com/v1

# Model used for indexing and summaries. Bare names are sent to
# OPENAI_BASE_URL. Model ids containing "/" must be prefixed with "openai/"
# (e.g. openai/meta-llama/Llama-3.3-70B-Instruct), otherwise LiteLLM reads
# the first segment as the provider name.
PAGEINDEX_INDEX_MODEL=your-model-name
