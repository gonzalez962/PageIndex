# Copy to .env and fill in. Never commit .env.

# --- Provider (required) ---------------------------------------------------
# OpenAI-compatible provider: API key and base URL (usually ends in /v1).
# Keyless local servers (Ollama, LM Studio, vLLM) still need a placeholder key.
# A provider running on this machine is reachable from the container at
# http://host.docker.internal:<port>/v1, not http://localhost.
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://your-provider.example.com/v1

# --- Models (optional; unset = SDK defaults) --------------------------------
# Bare names are sent to OPENAI_BASE_URL. Model ids containing "/" must be
# prefixed with "openai/" (e.g. openai/meta-llama/Llama-3.3-70B-Instruct),
# otherwise LiteLLM reads the first segment as the provider name.
# Uncomment and set real names; a placeholder left here is used literally.
#
# Indexing: tree structure and summaries (API and CLI).
# PAGEINDEX_INDEX_MODEL=
# Chat: answers questions over indexed documents (API only).
# PAGEINDEX_CHAT_MODEL=

# --- Per-role provider overrides (optional; API only) ------------------------
# Unset values fall back to OPENAI_BASE_URL / OPENAI_API_KEY.
# PAGEINDEX_INDEX_BASE_URL=
# PAGEINDEX_INDEX_API_KEY=
# PAGEINDEX_CHAT_BASE_URL=
# PAGEINDEX_CHAT_API_KEY=

# --- HTTP API (optional) -----------------------------------------------------
# When set, every endpoint except /health needs "Authorization: Bearer <token>".
# PAGEINDEX_API_TOKEN=
# Host port bound on 127.0.0.1 (default 8000).
# PAGEINDEX_PORT=8000
# Upload size limit in MB (default 50).
# PAGEINDEX_MAX_UPLOAD_MB=50
